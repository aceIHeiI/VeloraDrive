<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: el código de enlace y los datos de conexión no viajan en copias ni transferencias. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/phone_link.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/phone_link.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
