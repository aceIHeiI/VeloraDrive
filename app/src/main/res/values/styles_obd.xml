<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos de la pantalla OBD2 (archivo aparte para no chocar con themes.xml). -->
<resources>
    <style name="ObdGaugeBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">6dp</item>
        <item name="android:background">@drawable/obd_panel_fill</item>
        <item name="android:foreground">@drawable/obd_panel_stroke</item>
    </style>

    <style name="ObdCardValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ObdCardUnit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#8A96A3</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
