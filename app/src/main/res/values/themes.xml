<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Velora" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="30">always</item>
        <item name="alertDialogTheme">@style/VeloraDialog</item>
    </style>

    <style name="VeloraDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">default</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- Celdas de telemetría del cluster -->
    <style name="TeleCell">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="TeleIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="TeleValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold|italic</item>
    </style>

    <style name="TpmsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Panel de puesta a punto -->
    <style name="TuneLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TuneSeek">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:minHeight">12dp</item>
        <item name="android:maxHeight">12dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">@null</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:progressDrawable">@drawable/seek_track</item>
        <item name="android:splitTrack">false</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
    </style>

    <!-- Barra inferior -->
    <style name="BarBtn">
        <item name="android:layout_width">74dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/text</item>
    </style>

    <style name="BarDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginVertical">6dp</item>
        <item name="android:background">#0A0C0F</item>
    </style>

    <style name="StatusToggle">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">6dp</item>
        <item name="tint">@color/text_dim</item>
    </style>
    <!-- Quick settings -->
    <style name="QuickToggle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/toggle_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="QuickToggleIcon">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
    </style>

    <style name="QuickToggleText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="PresetPill">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/pill_preset</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@color/preset_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- Botones del reproductor mini (modo dividido) -->
    <style name="OverlayBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:background">@drawable/btn_glossy</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">#FFFFFF</item>
    </style>

    <style name="MiniTopBtn">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/mini_round_btn</item>
        <item name="android:padding">16dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">#FFFFFF</item>
    </style>

    <style name="OverlayTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
