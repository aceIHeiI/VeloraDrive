<?xml version="1.0" encoding="utf-8"?>
<!-- Perilla metálica de los sliders. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="18dp" android:height="30dp" />
            <gradient android:angle="270" android:endColor="#8A939C" android:startColor="#F2F5F8" />
            <stroke android:width="1dp" android:color="#5A636D" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
