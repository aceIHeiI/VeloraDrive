<?xml version="1.0" encoding="utf-8"?>
<!-- Botón atrás de la pantalla OBD2: solo borde, se tiñe con el color de cabina (backgroundTintList). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
