<?xml version="1.0" encoding="utf-8"?>
<!-- CAR SYNC / START: cápsula verde agua con halo luminoso. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#401DE9B6" /><stroke android:width="8dp" android:color="#401DE9B6" /><corners android:radius="32dp" /></shape></item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle"><solid android:color="#552A6B5E" /><stroke android:width="2.5dp" android:color="#5CFFD8" /><corners android:radius="28dp" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><stroke android:width="8dp" android:color="#261DE9B6" /><corners android:radius="32dp" /></shape></item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#1F3D3A" android:endColor="#0E1E1D" />
                    <stroke android:width="2.5dp" android:color="#1DE9B6" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
