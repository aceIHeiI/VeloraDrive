<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta OBD2 de la pantalla principal con lector conectado (o demo): borde verde. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape android:shape="rectangle"><solid android:color="#B3000000" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#12161C" />
            <stroke android:width="1.5dp" android:color="#3DDC84" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
