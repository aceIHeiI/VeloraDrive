<?xml version="1.0" encoding="utf-8"?>
<!-- Anterior / Siguiente: cápsula con borde neón y halo. Blanco: se tiñe con el color de cabina. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#40FFFFFF" /><stroke android:width="6dp" android:color="#33FFFFFF" /><corners android:radius="40dp" /></shape></item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle"><solid android:color="#00FFFFFF" /><stroke android:width="2.5dp" android:color="#FFFFFFFF" /><corners android:radius="37dp" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#14FFFFFF" /><stroke android:width="6dp" android:color="#1AFFFFFF" /><corners android:radius="40dp" /></shape></item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle"><solid android:color="#00FFFFFF" /><stroke android:width="2dp" android:color="#E6FFFFFF" /><corners android:radius="37dp" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
