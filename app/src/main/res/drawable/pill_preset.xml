<?xml version="1.0" encoding="utf-8"?>
<!--
    Presets (ROCK, POP, BASS, FLAT). Colores fijos: el activo en verde encendido con halo; los
    inactivos en carbono oscuro con relieve, para que nunca se confundan con el activo.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_activated="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="#1A24E07A" /><stroke android:width="7dp" android:color="#2624E07A" /><corners android:radius="16dp" /></shape></item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#1E3A2E" android:endColor="#0F1F18" />
                    <stroke android:width="2.5dp" android:color="#3DF28F" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3A4654" android:endColor="#222A33" />
            <stroke android:width="1.5dp" android:color="#6A7C8E" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#B3000000" /><corners android:radius="16dp" /></shape></item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#2B323A" android:centerColor="#1B2128" android:endColor="#14191F" />
                    <stroke android:width="1.5dp" android:color="#3A444F" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="3dp" android:gravity="top" android:left="12dp" android:right="12dp" android:top="1.5dp">
                <shape android:shape="rectangle"><size android:height="1dp" /><solid android:color="#33FFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
