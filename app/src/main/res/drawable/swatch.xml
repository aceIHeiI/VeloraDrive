<?xml version="1.0" encoding="utf-8"?>
<!-- Muestra circular del selector de tema: aro metálico + disco teñido con el color. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:endColor="#0B0D11" android:startColor="#46525F" />
        </shape>
    </item>
    <item android:id="@+id/swatchColor" android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
