<?xml version="1.0" encoding="utf-8"?>
<!-- Aro neón del botón Play/Pausa con halo amplio. Blanco: se tiñe con el color de cabina. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="#33FFFFFF" /><stroke android:width="10dp" android:color="#40FFFFFF" /></shape></item>
            <item android:bottom="7dp" android:left="7dp" android:right="7dp" android:top="7dp">
                <shape android:shape="oval"><solid android:color="#00FFFFFF" /><stroke android:width="4dp" android:color="#FFFFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="#00FFFFFF" /><stroke android:width="10dp" android:color="#1FFFFFFF" /></shape></item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="oval"><solid android:color="#00FFFFFF" /><stroke android:width="6dp" android:color="#38FFFFFF" /></shape>
            </item>
            <item android:bottom="7dp" android:left="7dp" android:right="7dp" android:top="7dp">
                <shape android:shape="oval"><solid android:color="#00FFFFFF" /><stroke android:width="4dp" android:color="#FFFFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
