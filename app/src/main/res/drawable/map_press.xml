<?xml version="1.0" encoding="utf-8"?>
<!-- Contorno al tocar el mapa. Blanco: se tiñe con el color de cabina. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="180">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1.5dp" android:color="#AAFFFFFF" />
            <corners android:bottomLeftRadius="16dp" android:bottomRightRadius="16dp" android:topLeftRadius="16dp" android:topRightRadius="22dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
