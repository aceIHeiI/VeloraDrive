<?xml version="1.0" encoding="utf-8"?>
<!-- Botones DÍA / NOCHE / MUTE. Activado: brillo interno radial y borde del color de cabina (tint). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:endColor="#14FFFFFF" android:gradientRadius="60%p" android:startColor="#55FFFFFF" android:type="radial" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF" />
                    <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#30FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:endColor="#08FFFFFF" android:startColor="#1CFFFFFF" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF" />
                    <stroke android:width="1dp" android:color="#2AFFFFFF" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
