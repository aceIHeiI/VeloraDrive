<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo grafito: gradiente radial metálico + micro-rejilla. Estático, sin animación. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08090B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.45"
                android:endColor="#0008090B"
                android:gradientRadius="70%p"
                android:startColor="#1A1E25"
                android:type="radial" />
        </shape>
    </item>
    <item android:drawable="@drawable/grid_texture" />
</layer-list>
