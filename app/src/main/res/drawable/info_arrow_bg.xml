<?xml version="1.0" encoding="utf-8"?>
<!-- Flechas ‹ › del recuadro de info: círculo oscuro con borde tenue. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#33FFFFFF" /><stroke android:width="1dp" android:color="#55FFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#12FFFFFF" /><stroke android:width="1dp" android:color="#2EFFFFFF" /></shape>
    </item>
</selector>
