<?xml version="1.0" encoding="utf-8"?>
<!-- Marco neón de la columna derecha (espejo del izquierdo). Blanco: se tiñe con el color de cabina. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="5dp" android:color="#26FFFFFF" />
            <corners
                android:bottomLeftRadius="14dp"
                android:bottomRightRadius="30dp"
                android:topLeftRadius="14dp"
                android:topRightRadius="30dp" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <stroke android:width="1.6dp" android:color="#FFFFFFFF" />
            <corners
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="28dp"
                android:topLeftRadius="12dp"
                android:topRightRadius="28dp" />
        </shape>
    </item>
</layer-list>
