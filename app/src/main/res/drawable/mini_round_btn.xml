<?xml version="1.0" encoding="utf-8"?>
<!-- Botones secundarios: círculo de vidrio oscuro (no se tiñe). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#59FFFFFF" /><stroke android:width="1.5dp" android:color="#99FFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#2EFFFFFF" /><stroke android:width="1.5dp" android:color="#4DFFFFFF" /></shape>
    </item>
</selector>
