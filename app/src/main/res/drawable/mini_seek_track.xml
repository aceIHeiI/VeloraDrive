<?xml version="1.0" encoding="utf-8"?>
<!-- Deslizador de volumen grueso. El tramo activo se tiñe con el acento. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal">
        <shape android:shape="rectangle"><size android:height="10dp" /><solid android:color="#40FFFFFF" /><corners android:radius="5dp" /></shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <clip><shape android:shape="rectangle"><size android:height="10dp" /><solid android:color="#FFFFFFFF" /><corners android:radius="5dp" /></shape></clip>
    </item>
</layer-list>
