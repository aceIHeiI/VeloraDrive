<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver: reloj gigante dentro de un aro de fuego que sigue el bajo. Cualquier toque lo cierra. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0"
    android:background="@drawable/bg_chassis"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <com.iheii.veloradrive.FlameGlowView
        android:id="@+id/flame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ssClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:shadowColor="#FFFF6D00"
                android:shadowRadius="14"
                android:textColor="#FFF3E0"
                android:textSize="110sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/ssAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-condensed"
                android:shadowColor="#FFFF6D00"
                android:shadowRadius="10"
                android:textColor="#FFF3E0"
                android:textSize="40sp"
                android:textStyle="bold|italic" />
        </LinearLayout>

        <TextView
            android:id="@+id/ssDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#AAFF3D00"
            android:shadowRadius="10"
            android:textColor="#FFE9D6"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Indicadores discretos en las esquinas inferiores -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ssGps"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_satellite"
            app:tint="#FFAB40" />

        <TextView
            android:id="@+id/ssParked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="P"
            android:textColor="#B0B8C0"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ssParkedCar"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="2dp"
            android:src="@drawable/ic_car"
            app:tint="#B0B8C0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ssWifi"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_wifi"
            app:tint="#8A939C" />

        <ImageView
            android:id="@+id/ssBt"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_bt"
            app:tint="#8A939C" />
    </LinearLayout>
</FrameLayout>
