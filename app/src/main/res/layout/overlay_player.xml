<?xml version="1.0" encoding="utf-8"?>
<!--
    Reproductor mini del modo dividido (flotante a la derecha, encima del mapa o de Android Auto).
    La portada llena el panel con un degradado estático; el texto, el progreso y los controles van
    encima. El ancho lo pone DriveOverlayService (35 % o 50 %); las medidas en dp ya vienen
    normalizadas a 1024x600 (designScaled), así se ve igual en 7, 9 y 10 pulgadas.
    Nada táctil mide menos de 56 dp. Lo blanco de borde, play, barra y etiqueta se tiñe con el acento.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="8dp">

    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/mini_panel_bg"
        android:foreground="@drawable/mini_panel_border">

        <!-- Portada de fondo -->
        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cover"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/mini_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <!-- Arriba: cambiar de fuente | minimizar a bolita, ampliar a música completa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton android:id="@+id/btnSource" style="@style/MiniTopBtn" android:contentDescription="@string/mini_source" android:src="@drawable/ic_swap" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <ImageButton android:id="@+id/btnMapFull" style="@style/MiniTopBtn" android:contentDescription="@string/mode_map_full" android:src="@drawable/ic_minimize" />
                <ImageButton android:id="@+id/btnMusicFull" style="@style/MiniTopBtn" android:layout_marginStart="10dp" android:contentDescription="@string/mode_music_full" android:src="@drawable/ic_expand" />
            </LinearLayout>

            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- Fuente, título (2 líneas) y artista -->
            <TextView
                android:id="@+id/source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mini_chip"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:breakStrategy="balanced"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:lineSpacingMultiplier="0.92"
                android:maxLines="2"
                android:shadowColor="#CC000000"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowRadius="6"
                android:textColor="#D3D9DF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/preset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/pill_active"
                    android:fontFamily="sans-serif-condensed"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="1dp"
                    android:textAllCaps="true"
                    android:textColor="#3DF28F"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btWarning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:maxLines="2"
                    android:text="@string/bt_warning"
                    android:textColor="#FFC24A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Progreso: barra gruesa con tiempos a los lados (solo con duración) -->
            <LinearLayout
                android:id="@+id/progressRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView android:id="@+id/pos" style="@style/OverlayTime" android:minWidth="44dp" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/mini_progress" />

                <TextView android:id="@+id/dur" style="@style/OverlayTime" android:gravity="end" android:minWidth="44dp" />
            </LinearLayout>

            <!-- Controles: Play/Pausa grande al centro, Anterior y Siguiente a los lados -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/prev"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/mini_round_btn"
                    android:contentDescription="@string/prev"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_prev"
                    app:tint="#FFFFFF" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/play"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/mini_play_bg"
                    android:contentDescription="@string/play_pause"
                    android:padding="24dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    app:tint="#FFFFFF" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/next"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/mini_round_btn"
                    android:contentDescription="@string/next"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <!-- Volumen en una fila: silencio, deslizador y porcentaje -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/mute"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mute"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_vol_up"
                    app:tint="#FFFFFF" />

                <SeekBar
                    android:id="@+id/volume"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/volume"
                    android:max="100"
                    android:maxHeight="10dp"
                    android:minHeight="10dp"
                    android:paddingHorizontal="14dp"
                    android:progressDrawable="@drawable/mini_seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/mini_seek_thumb" />

                <TextView
                    android:id="@+id/volumePct"
                    style="@style/OverlayTime"
                    android:gravity="end"
                    android:minWidth="48dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Mapa completo: queda solo esta bolita (se arrastra) para volver al dividido -->
    <ImageButton
        android:id="@+id/pill"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/play_fill"
        android:contentDescription="@string/mode_split"
        android:foreground="@drawable/btn_play_ring"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_music"
        android:visibility="gone"
        app:tint="#FFFFFF" />
</FrameLayout>
