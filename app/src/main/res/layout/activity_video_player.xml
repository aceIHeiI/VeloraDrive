<?xml version="1.0" encoding="utf-8"?>
<!--
    Reproductor de video a pantalla completa (diseño 1024x600 dp). PlayerView sin su controlador:
    los controles son propios, como en el diseño, y se ocultan solos a los 4 s (tocar los muestra).
    Bordes de chips y botones se pintan en código con el color de cabina.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Solo audio / video oculto en movimiento -->
    <LinearLayout
        android:id="@+id/centerInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/centerIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_v_headphones" />

        <TextView
            android:id="@+id/centerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxWidth="600dp"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/errorBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="600dp"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="@string/video_retry"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Barra superior -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="top"
            android:background="@drawable/video_scrim_top"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/obd_back_btn"
                android:contentDescription="@string/back"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B4BFCA"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipQuality"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/chipQualityIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v_tune" />

                <TextView
                    android:id="@+id/chipQualityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipAudio"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/chipAudioIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v_headphones" />

                <TextView
                    android:id="@+id/chipAudioText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/video_audio_only"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipMini"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/chipMiniIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v_pip" />

                <TextView
                    android:id="@+id/chipMiniText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/video_mini"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Barra inferior -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/video_scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="40dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:minWidth="44dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="14dp"
                    android:splitTrack="false" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="end"
                    android:minWidth="44dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="@string/video_prev"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_prev" />

                    <ImageButton
                        android:id="@+id/btnRewind"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="24dp"
                        android:contentDescription="@string/video_rewind"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_v_replay10" />

                    <ImageButton
                        android:id="@+id/btnPlay"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_marginStart="24dp"
                        android:background="@drawable/video_round_fill"
                        android:contentDescription="@string/video_play_pause"
                        android:padding="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_pause" />

                    <ImageButton
                        android:id="@+id/btnForward"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="24dp"
                        android:contentDescription="@string/video_forward"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_v_forward10" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="24dp"
                        android:contentDescription="@string/video_next"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/volIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_vol_up" />

                    <SeekBar
                        android:id="@+id/volume"
                        android:layout_width="180dp"
                        android:layout_height="40dp"
                        android:paddingHorizontal="12dp"
                        android:splitTrack="false" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Menú de calidad (se coloca debajo del chip al abrirlo) -->
        <LinearLayout
            android:id="@+id/qualityMenu"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="68dp"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
