<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Conexión con OfflineTune por la red local (WebSocket y portada) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Modo dividido: reproductor mini flotante encima de Maps o Waze -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- TripService: sigue contando los km con Android Auto encima -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Visualizer del screensaver: detecta los golpes de bajo de la música que suena -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <package android:name="com.zjinnova.zlink" />
        <package android:name="com.syu.ms" />
        <package android:name="com.tlink.carplay" />
        <package android:name="com.car17.carbitlink" />
        <package android:name="com.suding.speedplay" />
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.ts.main.eq" />
        <package android:name="com.syu.eq" />
        <package android:name="com.microntek.eq" />
        <package android:name="com.android.musicfx" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
        <package android:name="com.spotify.music" />
        <package android:name="deezer.android.app" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.syu.camera" />
        <package android:name="com.ts.camera" />
        <package android:name="com.microntek.avin" />
        <package android:name="com.fyt.camera" />
        <package android:name="com.syu.video" />
        <package android:name="com.microntek.media" />
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.syu.radio" />
        <package android:name="com.microntek.radio" />
        <package android:name="com.ts.radio" />
        <package android:name="com.android.fmradio" />
        <package android:name="com.android.fm" />
    </queries>

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:theme="@style/Theme.Velora">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.CAR_DOCK" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Pantalla OBD2 (medidores y códigos de falla). -->
        <activity
            android:name=".ObdActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Ajustes a pantalla completa: mismo tema, horizontal e inmersiva (goImmersive). -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Videos del celular (OfflineTune Car): biblioteca y reproductor. -->
        <activity
            android:name=".video.VideoLibraryActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Tarea propia: "Mini" (Picture-in-Picture) deja ver el launcher detrás; al cerrar vuelve a la anterior. -->
        <activity
            android:name=".video.VideoPlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.iheii.veloradrive.video"
            android:autoRemoveFromRecents="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Comparte el diagnóstico exportado desde Ajustes (cache/diagnostico). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diag_file_paths" />
        </provider>

        <!-- Necesario para leer la sesión de medios activa (Spotify, Android Auto, YouTube...). -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".DriveOverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".TripService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
